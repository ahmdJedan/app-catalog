# Salin file ini menjadi .env.local lalu isi dengan nilai sebenarnya.
# JANGAN commit .env.local ke Git.

# Connection string NeonDB (server-side only, tidak pernah diekspos ke client)
# Ambil dari Neon dashboard -> Connection Details -> "Pooled connection"
# Contoh: postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require


# Admin Authentication
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_SECRET=dsti_undip_secret_key_2026_super_secure
